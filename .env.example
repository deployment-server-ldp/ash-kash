APP_NAME="Ash & Kash"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# The storefront/admin are built and tested against MySQL. PostgreSQL also
# works via DB_CONNECTION=pgsql without any code changes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ash_kash_boutique
DB_USERNAME=boutique
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (transactional: order confirmation, shipping updates, password reset) ---
# EMAIL_PROVIDER is informational/for your own reference; MAIL_MAILER is what Laravel
# actually uses. Point MAIL_MAILER at 'smtp'/'ses'/'postmark'/'resend' etc. in production.
EMAIL_PROVIDER=log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Image storage --------------------------------------------------------
# 'local' (default) stores uploads under storage/app/public (served via `php artisan storage:link`).
# Set to 's3' and fill in the AWS_* keys to use S3-compatible object storage in production.
IMAGE_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Storefront / currency -------------------------------------------------
SHOP_BASE_CURRENCY=PKR
SHOP_DEFAULT_COUNTRY=PK
SHOP_COD_ENABLED=true

# Optional: only needed if you swap the IP geolocation driver for one that
# requires a paid API key (stevebauman/location supports several free drivers
# out of the box, e.g. ip-api.com, with no key required).
CURRENCY_API_KEY=

VITE_APP_NAME="${APP_NAME}"
